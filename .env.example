# PayPal SANDBOX REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# Copy to .env and fill in. Never commit .env, and never put real values in this file.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Webhook ID from your sandbox app's Webhooks section. Only needed for webhook testing.
PAYPAL_WEBHOOK_ID=

# Where the backend runs. PayPal sends the buyer back to APP_BASE_URL/paypal/return.
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./proofpay.db

# Passwords for the two fixed demo accounts, "client" and "freelancer".
DEMO_CLIENT_PASSWORD=client-demo
DEMO_FREELANCER_PASSWORD=freelancer-demo
